{
  "name": "joerny",
  "version": "0.1.0",
  "description": "Live browser companion for Joern — renders the typed layers a coding agent's CPG analysis emits.",
  "type": "module",
  "bin": {
    "joerny": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "node scripts/build-web.mjs",
    "dev": "npm run build && node dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "node --test dist-test",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "joern",
    "cpg",
    "visualization",
    "code-property-graph",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "3.6.0",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "20.14.10",
    "@types/ws": "8.5.10",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "cytoscape": "3.30.1",
    "cytoscape-dagre": "2.5.0",
    "dagre": "0.8.5",
    "esbuild": "0.25.0",
    "eslint": "8.57.0",
    "marked": "13.0.2",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=18"
  }
}
